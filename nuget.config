<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Machine-local DevExpress feed. The path is version-pinned and NuGet local sources
         take no wildcard, so this moves with the installed DevExpress major. When the
         installer is upgraded the old folder disappears and every restore fails with
         NU1301 "the local source doesn't exist" - repoint this and the DevExpress
         PackageReference versions together. -->
    <add key="DevExpressLocal" value="C:\Program Files\DevExpress 26.1\Components\System\Components\packages" />
  </packageSources>
</configuration>
